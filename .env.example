# Copy to .env and fill in
# Used by document_core.extraction's "llm_vision" backend (Claude multimodal
# vision extraction -- direct image/PDF -> structured fields, no layout model).
ANTHROPIC_API_KEY=

# Django (config/settings/*.py) -- required in prod, safe to leave blank for
# local dev (base.py falls back to an insecure dev key + sqlite).
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=
DJANGO_LOG_LEVEL=INFO

# postgres://user:password@host:5432/dbname -- leave blank to use the local
# SQLite file (db.sqlite3) instead.
DATABASE_URL=

# Where document_core.storage.DocumentStore writes uploaded files + metadata.
DOCUMENT_STORE_ROOT=

# Which document_core.ocr backend key the app calls by default.
DEFAULT_OCR_BACKEND=tesseract

# Path to a trained YOLO layout-detection checkpoint for layout_ocr.detection's
# LayoutDetector. Leave blank to run without one -- detection then fails
# loudly (LayoutDetectionUnavailable) instead of fabricating empty results.
LAYOUT_MODEL_WEIGHTS=

# Which document_core.extraction backend key the app calls by default:
# "layout_ocr" (YOLO layout + OCR pipeline, Phase 2) or "llm_vision" (direct
# multimodal-LLM extraction, no layout model).
DEFAULT_EXTRACTION_BACKEND=layout_ocr

# Which model document_core.extraction's "llm_vision" backend calls. Defaults
# to claude-opus-5 in code if unset.
LLM_EXTRACTION_MODEL=claude-opus-5
